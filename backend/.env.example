DJANGO_SECRET_KEY=change-me-in-production-use-32-plus-chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty to use SQLite for local development.
# Postgres example: postgres://gharswap:gharswap@localhost:5432/gharswap
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional: comma-separated extra trusted origins for CSRF (production frontend URL)
CSRF_TRUSTED_ORIGINS=
# Media uploads (local filesystem by default)
MEDIA_ROOT=
